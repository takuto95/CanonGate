    async def _critique_proposal(self, proposal_md: str, task_data: dict, grounding: str) -> dict:
        """Critic pass for proposal — checks rubric (Self-Refine, Reflexion).

        Rubric:
          1. 固有名詞 (固有のプロジェクト/人名/ADR/ファイル名) ≥ 3
          2. ADR or memory or grounding source への明示的引用 ≥ 1
          3. 各案で異なる trade-off 軸
          4. 「推奨案を覆しうる反論」が takuto論点に含まれる
          5. 一般論 (「複雑性が増加する」「既存システムを活用する」等) 不在

        Returns:
          {"approved": bool, "score": 0-10, "issues": str, "improvement_hints": str}
          fail-open: parse 失敗時は approved=True で第一稿を採用。
        """
        if not proposal_md or len(proposal_md.strip()) < 200:
            return {
                "approved": False, "score": 0,
                "issues": "出力が短すぎる",
                "improvement_hints": "もっと具体的に書け",
            }

        title = (task_data or {}).get("title", "")[:120]
        grounding_excerpt = (grounding or "")[:800]
        eval_prompt = (
            "あなたは厳格な Proposal 評価者。以下の提案markdownを5項目で採点する。\n"
            "Generator は自分の出力を過大評価する傾向 (self-eval blindness, Anthropic harness) があるため\n"
            "デフォルトで懐疑的に評価せよ。\n\n"
            f"## 対象タスク\n- {title}\n\n"
            f"## Grounding (利用可能だった事実ソース)\n```\n{grounding_excerpt}\n```\n\n"
            f"## Proposal markdown (評価対象)\n```\n{proposal_md[:3500]}\n```\n\n"
            "## 採点 rubric (各 0=満たさない / 1=部分的 / 2=満たす)\n"
            "1. **固有名詞密度**: プロジェクト名/メンバー名/ADR番号/ファイル名が 3 個以上ある\n"
            "2. **ソース引用**: ADR-####、memory、persons.json 由来の事実に明示的言及がある\n"
            "3. **trade-off 多様性**: A/B/C案がそれぞれ異なる判断軸 (工数/機能/保守性/リスク 等) を使い分けている\n"
            "4. **反論の存在**: takuto論点に『推奨案を覆しうる反論や代替視点』が1つ以上含まれる\n"
            "5. **一般論回避**: 『複雑性が増加する可能性がある』『既存システムを活用する』『機能の制限がある』等の汎用句が**無い**\n\n"
            "## 出力フォーマット (JSON only, no markdown fence, no other text)\n"
            '{"approved": true|false, "score": 0-10 (上記の合計), "scores": {"specificity": 0-2, "citation": 0-2, "diversity": 0-2, "rebuttal": 0-2, "no_generic": 0-2}, "issues": "1-2行の主要問題点", "improvement_hints": "1-2行の改善案"}\n\n'
            "判定基準: score ≥ 7 で approved=true。それ未満は false。"
        )
        messages = [
            {"role": "system", "content": "You are a strict proposal critic. Output JSON only. /no_think"},
            {"role": "user", "content": eval_prompt},
        ]
        full = ""
        try:
            full = await self._call_groq_streaming(messages, stream_to_tts=False)
        except Exception as e_groq:
            log.warning(f"Critic via Groq failed: {e_groq}")
            if self.config.anthropic_api_key:
                try:
                    full = await self._call_anthropic_streaming(messages, stream_to_tts=False)
                except Exception as e_anth:
                    log.warning(f"Critic via Anthropic failed: {e_anth}")
            if not full:
                try:
                    full = await self._call_ollama_fallback(messages, stream_to_tts=False)
                except Exception as fe:
                    log.warning(f"Critic via Ollama failed: {fe}")
                    return {"approved": True, "score": 0, "issues": "[critic unavailable; fail-open]", "improvement_hints": ""}

        m = re.search(r"\{[^{}]*\"approved\"[^{}]*(?:\{[^{}]*\}[^{}]*)*\}", full, re.DOTALL)
        if not m:
            log.warning(f"Critic returned no JSON. head={full[:120]}")
            return {"approved": True, "score": 0, "issues": "[critic parse failed; fail-open]", "improvement_hints": ""}
        try:
            data = json.loads(m.group(0))
        except Exception:
            return {"approved": True, "score": 0, "issues": "[critic JSON invalid; fail-open]", "improvement_hints": ""}

        # Normalize types
        for k, default in (("approved", False), ("score", 0), ("issues", ""), ("improvement_hints", "")):
            if k not in data:
                data[k] = default
        if isinstance(data.get("issues"), list):
            data["issues"] = "; ".join(str(x) for x in data["issues"])
        if isinstance(data.get("improvement_hints"), list):
            data["improvement_hints"] = "; ".join(str(x) for x in data["improvement_hints"])
        try:
            data["score"] = int(data["score"])
        except Exception:
            data["score"] = 0
        # Score-based override (deterministic)
        approved_by_score = data["score"] >= 7
        if bool(data.get("approved")) != approved_by_score:
            data["approved"] = approved_by_score
        return data

